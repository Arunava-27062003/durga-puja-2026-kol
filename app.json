{
  "expo": {
    "name": "durga-puja-2026-kol",
    "slug": "durga-puja-2026-kol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "durgapuja2026kol",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bdnpc.iema"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bidhannagar Durga Puja to use your location to find nearby pandals and services."
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Poppins-Regular.ttf", "./assets/fonts/Poppins-Italic.ttf"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a1a0bad-b88a-4c63-8c7c-8d7d9e1aafde"
      }
    }
  }
}
